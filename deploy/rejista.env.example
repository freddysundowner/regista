# Rejista server settings. install.sh creates /etc/rejista/rejista.env from this file on the first run, filling in
# the generated values marked "generated". Keep that file outside the code: it holds every secret the server has.
# One KEY=value per line, no quotes, no spaces around "=". Multi-line keys use \n escapes.
# Leave optional settings commented out rather than empty.

# --- Core (required) -------------------------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# hosted (many schools, sign-up, subscriptions) or standalone (one school)
DEPLOYMENT_MODE=hosted
# Public HTTPS address, no trailing slash. Bank and payment callbacks are built from it.
APP_BASE_URL=https://app.example.com
# PostgreSQL connection (generated for a local database)
DATABASE_URL=postgresql://rejista:CHANGE_ME@127.0.0.1:5432/rejista
# 32+ random characters for sign-in sessions (generated)
SESSION_SECRET=
# 32 random bytes, hex or base64 (generated). Encrypts bank and gateway credentials. NEVER change it after first use:
# everything encrypted with the old key becomes unreadable.
ENCRYPTION_KEY=
# One-time token for the first platform setup screen, 32+ characters (generated)
SETUP_TOKEN=
# Uploaded files, receipts, documents and the nightly database backups. Must survive new releases.
UPLOAD_DIR=/var/lib/rejista/storage
LOG_LEVEL=info

# --- Licensing --------------------------------------------------------------------------------------------------------
# Hosted server: private key for issuing standalone licences (pnpm --filter @workspace/api-server run licence:keygen)
# LICENCE_SIGNING_KEY=
# Standalone installs: the matching public key, and licensed (default) or open
# LICENCE_PUBLIC_KEY=
# STANDALONE_LICENSING=

# --- Banks ------------------------------------------------------------------------------------------------------------
# KCB's RSA public key for verifying Buni payment notifications. Get it from KCB. Put it on ONE line: either just
# the base64 text between the BEGIN/END lines, or the whole PEM with \n escapes inside double quotes.
# KCB_PUBLIC_KEY=
# Service provider printed on bank request letters
PROVIDER_BUSINESS_NAME=Regginna Technology Services
PROVIDER_CONTACT_NAME=Fredrick Mundia Githumbi
PROVIDER_CONTACT_EMAIL=githumbi3fred@gmail.com
PROVIDER_CONTACT_PHONE=0715 363 474

# --- Build time -------------------------------------------------------------------------------------------------------
# Used when building the web app: canonical link, sitemap.xml and robots.txt. Normally the same as APP_BASE_URL.
SITE_URL=https://app.example.com
# Proves to Google Search Console / Bing Webmaster Tools that you own the site, so you can submit the sitemap and
# ask for indexing. Paste only the code from the "HTML tag" verification method, then re-run the installer.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# --- Support assistant on the public website (optional) ---
# With a key, the chat on the landing page answers visitors from the knowledge base under
# Platform console → Knowledge base. Without one, tapped starter questions still get their
# article's answer and everything else waits for a person. Create a key at console.anthropic.com.
# ANTHROPIC_API_KEY=
# The model that writes answers. The default is the smallest, cheapest current Claude model.
# SUPPORT_AI_MODEL=claude-haiku-5-5
# Most assistant replies allowed in any 24 hours, across all chats.
# SUPPORT_AI_DAILY_CAP=1000

# --- Product name ---
# The name shown everywhere: screens, emails, PDFs, the support assistant and search-engine tags. Applied when the
# system is built, so re-run the installer after changing it. 2-40 letters, numbers, spaces, dots or hyphens.
# APP_NAME=Rejista
# The link-preview image and icons are pictures of the name "Rejista". After replacing og-image.png, favicon.svg and
# apple-touch-icon.png in artifacts/school-management/public with your own, set this to true.
# BRAND_IMAGES_READY=true
