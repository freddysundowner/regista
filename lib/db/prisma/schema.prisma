// ---------- Procurement ----------

/// Someone the school buys from.
model Supplier {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name String
  contactPerson String?
  phone String?
  email String?
  kraPin String?
  address String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders PurchaseOrder[]
  invoices SupplierInvoice[]
  @@unique([schoolId,name])
  @@map("suppliers")
}

/// Local purchase order (LPO): raised, approved by someone else, then received against.
model PurchaseOrder {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  number Int
  supplierId String @db.Uuid
  supplier Supplier @relation(fields:[supplierId], references:[id])
  date DateTime @db.Date
  neededBy DateTime? @db.Date
  notes String?
  status String @default("pending")
  total Decimal @db.Decimal(14,2)
  createdBy String @db.Uuid
  decidedBy String? @db.Uuid
  decidedAt DateTime?
  decisionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices SupplierInvoice[]
  @@unique([schoolId,number])
  @@index([schoolId,status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order PurchaseOrder @relation(fields:[orderId], references:[id])
  storeItemId String? @db.Uuid
  description String
  unit String?
  quantity Decimal @db.Decimal(12,2)
  unitPrice Decimal @db.Decimal(14,2)
  receivedQty Decimal @default(0) @db.Decimal(12,2)
  position Int
  @@index([orderId])
  @@map("purchase_order_lines")
}

/// Goods received note: what arrived against an LPO and when.
model GoodsReceipt {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  orderId String @db.Uuid
  order PurchaseOrder @relation(fields:[orderId], references:[id])
  date DateTime @db.Date
  deliveryNote String?
  note String?
  lines Json
  receivedBy String @db.Uuid
  createdAt DateTime @default(now())
  @@index([orderId])
  @@map("goods_receipts")
}

/// A supplier's bill. Paid by recording expenses against it; paid amount is worked out, not stored.
model SupplierInvoice {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  supplierId String @db.Uuid
  supplier Supplier @relation(fields:[supplierId], references:[id])
  orderId String? @db.Uuid
  order PurchaseOrder? @relation(fields:[orderId], references:[id])
  invoiceNo String
  date DateTime @db.Date
  dueDate DateTime? @db.Date
  description String
  category String
  amount Decimal @db.Decimal(14,2)
  attachmentUrl String?
  status String @default("active")
  voidReason String?
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,supplierId,invoiceNo])
  @@index([schoolId,status])
  @@map("supplier_invoices")
}

