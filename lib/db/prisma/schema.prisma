  /// Receipt or invoice scan: /api/storage/files/<id>.
  attachmentUrl String?
  recordedBy String @db.Uuid
  voidedBy String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,date])
  @@index([schoolId,status,category])
