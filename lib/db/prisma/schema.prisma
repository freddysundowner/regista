  termId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,userId,streamId,learningAreaId,termId])
  @@map("subject_assignments")
}
model Assessment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  termId String @db.Uuid
  gradeId String @db.Uuid
  learningAreaId String @db.Uuid
  name String
  type String
  maxMarks Decimal? @db.Decimal(8,2)
  weight Decimal @db.Decimal(8,2)
  date DateTime @db.Date
  status String @default("open")
  scaleSnapshot Json @default("[]")
  placementSnapshot Json @default("{}")
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,termId,gradeId])
  @@map("assessments")
}
model AssessmentResult {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
