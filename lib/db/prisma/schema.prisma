model GradeScale {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  gradeId String @unique @db.Uuid
  scaleId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
