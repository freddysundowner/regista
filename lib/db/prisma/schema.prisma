generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model School {
  id String @id @default(uuid()) @db.Uuid
  name String
  code String @unique
  county String?
  type String
  address String?
  phone String?
  email String?
  status String @default("active")
  registrationNote String?
  logoUrl String?
  settings Json @default("{}")
  subscriptionPlan String @default("foundation")
  subscriptionStatus String @default("trial")
  subscriptionStartDate DateTime? @db.Date
  subscriptionEndDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  years AcademicYear[]
  terms Term[]
  grades Grade[]
  streams Stream[]
  students Student[]
  guardians Guardian[]
  families Family[]
  logs AuditLog[]
  files StoredFile[]
  tenantGrants PlatformTenantGrant[]
  platformAudits PlatformAudit[]
  platformInvoices PlatformBillingInvoice[]
  licenceManaged Boolean @default(false)
  licences SchoolLicence[]
  licenceOrders LicenceOrder[]
  @@map("schools")
}
model PlatformBillingInvoice {
  id String @id @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  number String @unique
  description String
  amount Decimal @db.Decimal(12,2)
  issuedOn DateTime @db.Date
  dueOn DateTime @db.Date
  periodStart DateTime? @db.Date
  periodEnd DateTime? @db.Date
  voidedAt DateTime?
  createdAt DateTime @default(now())
  payments PlatformBillingPayment[]
  licenceOrder LicenceOrder?
  @@index([schoolId,createdAt])
  @@map("platform_billing_invoices")
}
model LicencePlan {
  id String @id @default(uuid()) @db.Uuid
  name String
  description String @default("")
  durationDays Int
  price Decimal @db.Decimal(12,2)
  subscriptionPrice Decimal @db.Decimal(12,2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  licences SchoolLicence[]
  orders LicenceOrder[]
  @@map("licence_plans")
}
model SchoolLicence {
  id String @id @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  planId String @db.Uuid
  plan LicencePlan @relation(fields:[planId], references:[id])
  planName String
  durationDays Int
  price Decimal @db.Decimal(12,2)
  startsAt DateTime
  expiresAt DateTime
  requestedStartsAt DateTime?
  source String
  revokedAt DateTime?
  revocationType String?
  createdAt DateTime @default(now())
  order LicenceOrder?
  @@index([schoolId,startsAt,expiresAt])
  @@map("school_licences")
}
model LicenceOrder {
  id String @id @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  planId String @db.Uuid
  plan LicencePlan @relation(fields:[planId], references:[id])
  planName String
  durationDays Int
  price Decimal @db.Decimal(12,2)
  invoiceId String @unique @db.Uuid
  invoice PlatformBillingInvoice @relation(fields:[invoiceId], references:[id])
  licenceId String? @unique @db.Uuid
  licence SchoolLicence? @relation(fields:[licenceId], references:[id])
  createdAt DateTime @default(now())
  @@index([schoolId,createdAt])
  @@map("licence_orders")
}
model PlatformBillingPayment {
  id String @id @db.Uuid
  invoiceId String @db.Uuid
  invoice PlatformBillingInvoice @relation(fields:[invoiceId], references:[id])
  amount Decimal @db.Decimal(12,2)
  paidOn DateTime @db.Date
  method String
  reference String
  reversedAt DateTime?
  createdAt DateTime @default(now())
  @@index([invoiceId])
  @@map("platform_billing_payments")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  schoolId String? @db.Uuid
  school School? @relation(fields:[schoolId], references:[id])
  sessionSchoolId String? @db.Uuid
  name String
  email String? @unique
  phone String? @unique
  passwordHash String
  role String
  isActive Boolean @default(true)
  lastLoginAt DateTime?
  sessionVersion Int @default(0)
  assignments TeacherAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  streams Stream[]
  logs AuditLog[]
  tenantGrants PlatformTenantGrant[]
  platformAudits PlatformAudit[]
  @@index([schoolId])
  @@map("users")
}
model PlatformTenantGrant {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields:[actorId], references:[id])
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  sessionId String
  sessionVersion Int
  reason String
  writeEnabled Boolean @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  audits PlatformAudit[]
  @@index([actorId, sessionId])
  @@map("platform_tenant_grants")
}
model PlatformAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  actor User @relation(fields:[actorId], references:[id])
  schoolId String? @db.Uuid
  school School? @relation(fields:[schoolId], references:[id])
  grantId String? @db.Uuid
  grant PlatformTenantGrant? @relation(fields:[grantId], references:[id])
  action String
  reason String
  entityId String?
  before Json?
  after Json?
  ip String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([schoolId, createdAt])
  @@map("platform_audits")
}
model AcademicYear {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  name String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  isCurrent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms Term[]
  @@unique([schoolId,name])
  @@map("academic_years")
}
model Term {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  academicYearId String @db.Uuid
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id])
  name String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  isCurrent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([academicYearId,name])
  @@index([schoolId])
  @@map("terms")
}
model Grade {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  name String
  levelBand String
  order Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  streams Stream[]
  students Student[]
  @@unique([schoolId,name])
  @@map("grades")
}
model Stream {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  gradeId String @db.Uuid
  grade Grade @relation(fields:[gradeId], references:[id])
  name String
  classTeacherUserId String? @db.Uuid
  classTeacher User? @relation(fields:[classTeacherUserId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  students Student[]
  assignments TeacherAssignment[]
  @@unique([gradeId,name])
  subjectAssignments SubjectAssignment[]
  @@unique([id,schoolId])
  @@index([schoolId])
  @@map("streams")
}
model Student {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  admissionNo String
  firstName String
  middleName String?
  lastName String
  gender String?
  dateOfBirth DateTime? @db.Date
  gradeId String? @db.Uuid
  grade Grade? @relation(fields:[gradeId], references:[id])
  streamId String? @db.Uuid
  stream Stream? @relation(fields:[streamId], references:[id])
  status String @default("active")
  boardingStatus String @default("day")
  admissionDate DateTime? @db.Date
  upi String?
  pathway String?
  photoUrl String?
  transportRouteId String?
  familyId String? @db.Uuid
  family Family? @relation(fields:[familyId], references:[id])
  guardians StudentGuardian[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,admissionNo])
  @@index([schoolId,streamId])
  @@map("students")
}
model Guardian {
  whatsappLastInboundAt DateTime?
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  name String
  phone String
  altPhone String?
  email String?
  relationship String?
  idNumber String?
  anonymizedAt DateTime?
  students StudentGuardian[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,phone])
  @@map("guardians")
}
model StudentGuardian {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  guardianId String @db.Uuid
  student Student @relation(fields:[studentId], references:[id])
  guardian Guardian @relation(fields:[guardianId], references:[id])
  relationship String
  isPrimary Boolean @default(false)
  receivesNotifications Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId,guardianId])
  @@index([schoolId])
  @@map("student_guardians")
}
model Family {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  name String
  students Student[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
  @@map("families")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  userId String? @db.Uuid
  user User? @relation(fields:[userId], references:[id])
  action String
  entityType String
  entityId String?
  before Json?
  after Json?
  ip String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,createdAt])
  @@map("audit_logs")
}
model TeacherAssignment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id])
  streamId String @db.Uuid
  stream Stream @relation(fields:[streamId], references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId,streamId])
  @@index([schoolId])
  @@map("teacher_assignments")
}
model StoredFile {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school School @relation(fields:[schoolId], references:[id])
  ownerId String @db.Uuid
  entityType String
  entityId String @db.Uuid
  objectKey String @unique
  filename String
  contentType String
  size Int
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId])
  @@map("stored_files")
}

model FinanceRecord {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  kind String
  studentId String? @db.Uuid
  termId String? @db.Uuid
  parentId String? @db.Uuid
  status String @default("draft")
  amount Decimal @default(0) @db.Decimal(14,2)
  data Json @default("{}")
  requestedBy String @db.Uuid
  approvedBy String? @db.Uuid
  approvedAt DateTime?
  uniqueKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,kind,uniqueKey])
  @@index([schoolId,kind,studentId])
  @@map("finance_records")
}
model LedgerEntry {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  termId String? @db.Uuid
  type String
  debit Decimal @db.Decimal(14,2)
  credit Decimal @db.Decimal(14,2)
  referenceId String @db.Uuid
  referenceType String
  description String
  createdBy String @db.Uuid
  reversesId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  @@unique([schoolId,referenceId,type])
  @@index([schoolId,studentId,createdAt])
  @@map("ledger_entries")
}
model StudentBalance {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @unique @db.Uuid
  balance Decimal @default(0) @db.Decimal(14,2)
  updatedAt DateTime @updatedAt
  @@index([schoolId])
  @@map("student_balances")
}
model InvoiceLine {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  invoiceId String @db.Uuid
  feeItemId String @db.Uuid
  description String
  priority Int
  amount Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  @@index([schoolId,studentId,invoiceId])
  @@map("invoice_lines")
}
model FeeAllocation {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  sourceId String @db.Uuid
  invoiceId String @db.Uuid
  invoiceLineId String @db.Uuid
  amount Decimal @db.Decimal(14,2)
  createdBy String @db.Uuid
  reversesId String? @unique @db.Uuid
  createdAt DateTime @default(now())
  @@index([schoolId,studentId,sourceId])
  @@map("fee_allocations")
}
model FinanceCounter {
  schoolId String @id @db.Uuid
  invoice Int @default(0)
  receipt Int @default(0)
  @@map("finance_counters")
}
model FinanceOutbox {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  event String
  referenceId String @db.Uuid
  payload Json
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@unique([schoolId,event,referenceId])
  @@map("finance_outbox")
}

model IntegrationConfig {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  provider String
  environment String @default("sandbox")
  encryptedCredentials String
  publicConfig Json @default("{}")
  callbackTokenHash String? @unique
  apiKeyHash String? @unique
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,provider])
  @@map("integration_configs")
}
model IncomingPayment {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  provider String
  providerTxnId String
  channel String
  amount Decimal @db.Decimal(14,2)
  transactionTime DateTime
  payerPhone String?
  payerName String?
  accountReference String?
  normalizedReference String?
  bankAccountFrom String?
  source String
  rawPayload Json
  status String @default("received")
  knownStudentId String? @db.Uuid
  duplicateOfId String? @db.Uuid
  requestedBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,provider,providerTxnId])
  @@index([schoolId,status,createdAt])
  @@map("incoming_payments")
}
model PaymentStudentAllocation {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  paymentId String @db.Uuid
  studentId String @db.Uuid
  postingId String @unique @db.Uuid
  amount Decimal @db.Decimal(14,2)
  allocatedBy String @db.Uuid
  allocatedAt DateTime @default(now())
  @@unique([paymentId,studentId])
  @@index([schoolId,studentId])
  @@map("payment_student_allocations")
}
model MatchException {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  paymentId String @unique @db.Uuid
  reason String
  candidates Json
  familyId String? @db.Uuid
  expiresAt DateTime?
  status String @default("open")
  resolution String?
  resolvedBy String? @db.Uuid
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId,status,createdAt])
  @@map("match_exceptions")
}
model PayerAlias {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  type String
  value String
  studentId String? @db.Uuid
  familyId String? @db.Uuid
  source String
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,type,value,studentId])
  @@index([schoolId,type,value])
  @@map("payer_aliases")
}
model StkRequest {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  phone String
  amount Decimal @db.Decimal(14,2)
  idempotencyKey String
  checkoutRequestId String? @unique
  merchantRequestId String?
  status String @default("created")
  resultCode String?
  requestedBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,idempotencyKey])
  @@index([schoolId,status])
  @@map("stk_requests")
}
model IntegrationEvent {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  provider String
  event String
  status String
  detail Json
  createdAt DateTime @default(now())
  @@index([schoolId,createdAt])
  @@map("integration_events")
}
model ReconciliationRun {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  provider String
  fromDate DateTime
  toDate DateTime
  status String
  statementCount Int
  systemCount Int
  statementTotal Decimal @db.Decimal(14,2)
  systemTotal Decimal @db.Decimal(14,2)
  discrepancies Json
  createdAt DateTime @default(now())
  @@index([schoolId,createdAt])
  @@map("reconciliation_runs")
}
model MessageDelivery {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  guardianId String? @db.Uuid
  phone String
  channel String
  template String
  content String
  idempotencyKey String
  status String @default("queued")
  providerMessageId String?
  transportAccountId String? @db.Uuid
  transportProvider String?
  attempts Int @default(0)
  error String?
  scheduledAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,idempotencyKey])
  @@index([transportAccountId,providerMessageId])
  @@index([schoolId,status,scheduledAt])
  @@map("message_deliveries")
}
model MessagingAccount {
  id String @id @default(uuid()) @db.Uuid
  scope String
  channel String
  mode String @default("override")
  provider String?
  enabled Boolean @default(false)
  environment String @default("live")
  publicConfig Json @default("{}")
  encryptedCredentials String?
  callbackTokenHash String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([scope,channel])
  @@map("messaging_accounts")
}
model BotReplay {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  signatureHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([schoolId,signatureHash])
  @@map("bot_replays")
}
model GuardianVerification {
