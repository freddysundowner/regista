  studentId String @db.Uuid
  subStrandId String? @db.Uuid
  cellKey String
  marks Decimal? @db.Decimal(8,2)
  performanceLevelId String @db.Uuid
  overrideReason String?
  comment String?
  enteredBy String @db.Uuid
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([assessmentId,studentId,cellKey])
  @@index([schoolId,studentId])
  @@map("assessment_results")
}
model LearnerRating {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  termId String @db.Uuid
  category String
  code String
  performanceLevelId String @db.Uuid
  enteredBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,studentId,termId,category,code])
  @@map("learner_ratings")
}
model ReportCard {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  termId String @db.Uuid
  classTeacherComment String?
  headTeacherComment String?
  nextTermOpeningDate DateTime? @db.Date
  fileId String? @db.Uuid
  status String @default("draft")
  publishedAt DateTime?
  resultSnapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId,studentId,termId])
  @@map("report_cards")
}
model AttendanceRecord {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  studentId String @db.Uuid
  streamId String @db.Uuid
  date DateTime @db.Date
  status String
  markedBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([studentId,date])
  @@index([schoolId,streamId,date])
  @@map("attendance_records")
}
model CollectionRefund {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  paymentId String @unique @db.Uuid
  exceptionId String @unique @db.Uuid
  amount Decimal @db.Decimal(14,2)
  reason String
  status String @default("pending")
  requestedBy String @db.Uuid
  decidedBy String? @db.Uuid
  decisionReason String?
  decidedAt DateTime?
  paidReference String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("collection_refunds")
}
model SuspenseEntry {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  paymentId String @db.Uuid
  event String
  debit Decimal @default(0) @db.Decimal(14,2)
  credit Decimal @default(0) @db.Decimal(14,2)
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([paymentId,event])
  @@map("suspense_entries")
}
model SponsorBatch {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  paymentId String @unique @db.Uuid
  sponsorId String @db.Uuid
  allocatedAmount Decimal @db.Decimal(14,2)
  heldAmount Decimal @db.Decimal(14,2)
  remainderReason String?
  requestedBy String @db.Uuid
  status String @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("sponsor_batches")
}
model SponsorAllocation {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  batchId String @db.Uuid
  studentId String @db.Uuid
  financeRecordId String @unique @db.Uuid
  amount Decimal @db.Decimal(14,2)
  @@unique([batchId,studentId])
  @@map("sponsor_allocations")
}