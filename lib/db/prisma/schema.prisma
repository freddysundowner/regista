}

// ---------- Library ----------

model LibraryBook {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  title String
  author String?
  isbn String?
  publisher String?
  category String
  subject String?
  level String?
  shelf String?
  /// Set when a book with borrowing history is deleted: it leaves the catalogue, its past loans keep the title.
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  copies LibraryCopy[]
  @@index([schoolId,title])
  @@map("library_books")
}

/// One physical book, known by its accession number.
model LibraryCopy {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  bookId String @db.Uuid
  book LibraryBook @relation(fields:[bookId], references:[id])
  accessionNo String
  status String @default("available")
  /// Set when a copy with borrowing history is deleted; its accession number stays used.
  deletedAt DateTime?
  createdAt DateTime @default(now())
  loans LibraryLoan[]
  @@unique([schoolId,accessionNo])
  @@index([bookId])
  @@map("library_copies")
}

model LibraryLoan {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  copyId String @db.Uuid
  copy LibraryCopy @relation(fields:[copyId], references:[id])
  studentId String? @db.Uuid
  userId String? @db.Uuid
  borrowerName String
  issuedAt DateTime @db.Date
  dueDate DateTime @db.Date
  returnedAt DateTime? @db.Date
  status String @default("out")
  returnNote String?
  issuedBy String @db.Uuid
  returnedBy String? @db.Uuid
  createdAt DateTime @default(now())
  @@index([schoolId,status])
  @@index([copyId])
  @@index([studentId])
  @@map("library_loans")
}
/// Support chat. A conversation (threadId) belongs to one staff member ("staff-<userId>") or one
/// website visitor ("visitor-<visitorId>"); the platform's support desk answers in it.
model SupportMessage {
  id String @id @default(uuid()) @db.Uuid
  threadId String
  schoolId String? @db.Uuid
  userId String? @db.Uuid
  visitorId String? @db.Uuid
  senderId String? @db.Uuid
  fromSupport Boolean @default(false)
  byAi Boolean @default(false)
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  school School? @relation(fields:[schoolId], references:[id])
  user User? @relation(fields:[userId], references:[id])
  visitor SupportVisitor? @relation(fields:[visitorId], references:[id])
  @@index([threadId, createdAt])
  @@index([fromSupport, readAt])
  @@map("support_messages")
}
/// Someone chatting from the public landing page. Their browser holds the token; only its hash is stored.
model SupportVisitor {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  name String
  contact String?
  createdAt DateTime @default(now())
  messages SupportMessage[]
  @@map("support_visitors")
}
/// What the support assistant knows. Published articles are its only source; starters are offered as tappable questions.
model KnowledgeArticle {
  id String @id @default(uuid()) @db.Uuid
  question String
  answer String
  isPublished Boolean @default(true)
  isStarter Boolean @default(false)
  /// "visitors" (the public website), "staff" (signed-in school staff) or "all".
  audience String @default("all")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@map("knowledge_articles")
}
/// A one-time link emailed to someone who forgot their password. Only the hash of its token is stored.
model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("password_resets")
}
