  quantity Decimal @db.Decimal(12,2)
  balanceAfter Decimal @db.Decimal(12,2)
  unitCost Decimal? @db.Decimal(14,2)
  date DateTime @db.Date
  issuedTo String?
  reference String?
  note String?
  orderId String? @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
